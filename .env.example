# Copy this file to .env and fill in real values for local development.
# Never commit .env or any file containing real credentials.

# --- Database (PostgreSQL only — SQLite is no longer supported) ---
# Matches the local Postgres service defined in docker-compose.yml.
DATABASE_URL="postgresql://collabpro:changeme@localhost:5432/collabpro_production?schema=public"
# Password for the docker-compose "postgres" service (must match the credential in DATABASE_URL above).
DB_PASSWORD="changeme"
# Max connections in the pg.Pool used by lib/db.ts. Keep this low per running process/service
# (e.g. web + ws) so the sum stays under your Postgres server's max_connections.
DB_POOL_MAX="10"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth / sessions ---
# Random 32+ character secret used to sign session JWTs.
SESSION_SECRET="your-random-32-character-secret-here"
# Shared secret required by internal notification/security-audit webhook endpoints.
NOTIFICATION_SECRET="your-notification-secret-here"
# Comma-separated list of emails allowed to access admin-only routes (e.g. /api/admin/telemetry).
# Fails closed when unset — every request is denied, not allowed, until this is configured.
ADMIN_EMAILS="admin@example.com"

# --- Object storage (S3-compatible) ---
S3_ENDPOINT="https://your-s3-endpoint.example.com"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET_NAME="your-bucket-name"

# --- Outbound email (SMTP) ---
SMTP_SERVER="smtp.example.com"
SMTP_USERNAME="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
NOTIFICATION_EMAIL="notifications@example.com"

# --- Third-party integrations ---
GITHUB_TOKEN="your-github-token-here"
SONAR_TOKEN="your-sonarcloud-token-here"
SNYK_ORG_ID="your-snyk-org-id-here"
SNYK_TOKEN="your-snyk-token-here"
YOUTUBE_CLIENT_ID="your-youtube-oauth-client-id"
YOUTUBE_CLIENT_SECRET="your-youtube-oauth-client-secret"
YOUTUBE_REFRESH_TOKEN="your-youtube-oauth-refresh-token"

# --- WebSocket server (ws-server/) ---
# Port the standalone WS server listens on (PORT takes precedence over WS_PORT if both are set).
WS_PORT="4000"

# --- Client-side / misc ---
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_GOOGLE_ADS_CLIENT_ID="your-google-ads-client-id"
LOG_LEVEL="INFO"
NODE_ENV="development"
